# Firma de producción con la clave de INTI.
# Copia este archivo como keystore.properties (en esta misma carpeta, android/) y completa los datos.
# keystore.properties y la clave (.jks / .keystore) NO se suben a git: guárdalos con respaldo, porque
# sin ellos no se pueden publicar actualizaciones de la app.

# Ruta a la clave, relativa a esta carpeta (android/) o absoluta.
storeFile=../../claves/inti-release.jks
storePassword=CONTRASEÑA_DEL_ALMACEN
keyAlias=ALIAS_DE_LA_CLAVE
keyPassword=CONTRASEÑA_DE_LA_CLAVE
